rules_version = '2';

// ══════════════════════════════════════════════════════════════════════
//  GroupTask — Firestore Security Rules
//
//  Design Principles:
//  1. Default-deny: No access unless explicitly granted.
//  2. Group membership enforced: Users can only read/write data that
//     belongs to a group they are a member of.
//  3. Ownership enforced: Users can only modify records they own
//     (e.g., their own peer reviews, their own events).
//  4. Admins have elevated write permissions within their group.
//  5. Sensitive collections (peerReviews) are restricted so only the
//     reviewer can read their own submitted review; evaluatees cannot.
// ══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reusable Helper Functions ────────────────────────────────────

    /**
     * Returns true if the requesting user is authenticated.
     */
    function isAuthed() {
      return request.auth != null;
    }

    /**
     * Checks if a 'members' doc exists for this user in the given group.
     * Uses the groupId + uid composite pattern from the members store.
     */
    function isMemberOfGroup(groupId) {
      return isAuthed() &&
        exists(/databases/$(database)/documents/members/$(groupId + '_' + request.auth.uid));
    }

    /**
     * Returns true if the user is the creator/admin of a group.
     */
    function isGroupAdmin(groupId) {
      return isAuthed() && (
        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/members/$(groupId + '_' + request.auth.uid)) &&
          get(/databases/$(database)/documents/members/$(groupId + '_' + request.auth.uid)).data.role in ['owner', 'co-admin']
        )
      );
    }

    /**
     * Returns true if the incoming write data contains a `groupId`
     * field and the user is a member of that group.
     */
    function isWritingToOwnGroup() {
      return isAuthed() &&
        'groupId' in request.resource.data &&
        isMemberOfGroup(request.resource.data.groupId);
    }

    // ── Groups ───────────────────────────────────────────────────────
    // Any authenticated user can read a group (needed to resolve invite codes).
    // Only the creator (admin) can update or delete the group.
    match /groups/{groupId} {
      allow read: if isAuthed();
      allow create: if isAuthed() &&
        request.resource.data.createdBy == request.auth.uid;
      // Admin can do any update except scoresHidden (A4). Any authed user can update ONLY to add a join request.
      allow update: if (isGroupAdmin(groupId) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['scoresHidden'])) ||
        (isAuthed() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinRequests', 'updatedAt']));
      allow delete: if isGroupAdmin(groupId);
    }

    // ── Members ──────────────────────────────────────────────────────
    // Any group member can read the member list of their group.
    // A user can only create their own membership record.
    // Only the member themselves or a group admin can update/delete.
    match /members/{memberId} {
      allow read: if isAuthed() && (
        resource.data.uid == request.auth.uid ||
        isMemberOfGroup(resource.data.groupId)
      );
      allow create: if isAuthed() && 'groupId' in request.resource.data && (
        // Case 1: Group admin adds or accepts a member (B2)
        isGroupAdmin(request.resource.data.groupId) ||
        // Case 2: Group owner creates their initial membership
        (request.resource.data.uid == request.auth.uid &&
         get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid) ||
        // Case 3: User joins with a valid invite code
        (request.resource.data.uid == request.auth.uid &&
         'inviteCode' in request.resource.data &&
         request.resource.data.inviteCode == get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode)
      );
      allow update: if isAuthed() && (
        resource.data.uid == request.auth.uid ||
        isGroupAdmin(resource.data.groupId)
      );
      allow delete: if isAuthed() && (
        resource.data.uid == request.auth.uid ||
        isGroupAdmin(resource.data.groupId)
      );
    }

    // ── Tasks ────────────────────────────────────────────────────────
    // Read:   any group member.
    // Create: any group member, but initial status must not be 'done' —
    //         tasks must go through the approval workflow.
    // Update: assignee can move their own card to todo/in-progress/pending-approval.
    //         Only owner/co-admin can set status='done' or change task weight.
    // Delete: only group admin.
    //
    // NOTE: weight is locked after creation — only admins may change it to
    // prevent members from inflating their own WPS contribution scores.
    match /tasks/{taskId} {
      allow read: if isAuthed() &&
        isMemberOfGroup(resource.data.groupId);

      allow create: if isWritingToOwnGroup() &&
        request.resource.data.status != 'done';

      allow update: if isAuthed() && isMemberOfGroup(resource.data.groupId) && (
        // Admins can update tasks, but to set status='done', the admin cannot be the assignee (B4)
        (isGroupAdmin(resource.data.groupId) && (
          request.resource.data.status != 'done' ||
          resource.data.assignedTo != (resource.data.groupId + '_' + request.auth.uid)
        )) ||
        (
          // Members may update if they are ALREADY the assignee, OR they are self-assigning an unassigned task
          (
            resource.data.assignedTo == (resource.data.groupId + '_' + request.auth.uid) ||
            (resource.data.assignedTo == null && request.resource.data.assignedTo == (resource.data.groupId + '_' + request.auth.uid))
          ) &&
          // ...and may NOT move directly to 'done' (must go through approval)
          request.resource.data.status != 'done' &&
          // ...and may NOT change the weight (protects score integrity)
          request.resource.data.weight == resource.data.weight
        )
      );

      allow delete: if isAuthed() &&
        isGroupAdmin(resource.data.groupId);
    }

    // ── Comments ─────────────────────────────────────────────────────
    // Any group member can read and create comments.
    // NOTE: memberId stores the composite 'groupId_uid' member record ID,
    // NOT the raw Firebase UID — so we cannot compare it to request.auth.uid
    // directly. Instead we verify group membership and use the composite pattern.
    match /comments/{commentId} {
      allow read: if isAuthed() &&
        isMemberOfGroup(resource.data.groupId);

      // Any authenticated group member can post a comment.
      // The app sets memberId = groupId + '_' + uid, which we verify here.
      allow create: if isWritingToOwnGroup() &&
        request.resource.data.memberId == (request.resource.data.groupId + '_' + request.auth.uid);

      // Only the original commenter can edit their own comment.
      allow update: if isAuthed() &&
        isMemberOfGroup(resource.data.groupId) &&
        resource.data.memberId == (resource.data.groupId + '_' + request.auth.uid);

      // The author or a group admin can delete a comment.
      allow delete: if isAuthed() && (
        resource.data.memberId == (resource.data.groupId + '_' + request.auth.uid) ||
        isGroupAdmin(resource.data.groupId)
      );
    }

    // ── Peer Reviews (Evaluation) ─────────────────────────────────────
    // Sensitive: only the reviewer can read their own submitted review.
    // The evaluatee CANNOT read reviews about themselves (only the
    // aggregated average score is exposed via their member record).
    // Group admin CAN read all reviews for governance/oversight.
    match /peerReviews/{reviewId} {
      // A1: Individual peer ratings are strictly private — only the reviewer can read them
      allow read: if isAuthed() &&
        resource.data.reviewerId == request.auth.uid;
      allow create: if isWritingToOwnGroup() &&
        request.resource.data.reviewerId == request.auth.uid &&
        // Prevent self-review (evaluateeId is groupId_uid) (A1 bug fix)
        request.resource.data.evaluateeId != (request.resource.data.groupId + '_' + request.auth.uid);
      // A reviewer can update/overwrite their own review
      allow update: if isAuthed() &&
        resource.data.reviewerId == request.auth.uid &&
        // Cannot change who is being reviewed after submission
        request.resource.data.evaluateeId == resource.data.evaluateeId;
      allow delete: if isAuthed() &&
        isGroupAdmin(resource.data.groupId);
    }

    // ── Peer Ratings (Legacy numeric ratings) ────────────────────────
    match /peerRatings/{ratingId} {
      allow read: if isAuthed() &&
        isMemberOfGroup(resource.data.groupId);
      allow create: if isWritingToOwnGroup();
      allow update, delete: if isAuthed() &&
        isMemberOfGroup(resource.data.groupId);
    }

    // ── Badges ───────────────────────────────────────────────────────
    // All group members can read badges (shown on leaderboard).
    // Only the badge owner can create their own badge record.
    // Badges are immutable once awarded — no updates or user deletes.
    match /badges/{badgeId} {
      allow read: if isAuthed() &&
        isMemberOfGroup(resource.data.groupId);
      // B5: Allow badge owner or group admin to write badges for group members
      allow create: if isAuthed() &&
        isMemberOfGroup(request.resource.data.groupId) &&
        (
          request.resource.data.uid == request.auth.uid ||
          isGroupAdmin(request.resource.data.groupId)
        );
      allow update: if false; // Badges are immutable once awarded
      allow delete: if isAuthed() &&
        isGroupAdmin(resource.data.groupId);
    }

    // ── Gamification Events ──────────────────────────────────────────
    // Events are an append-only ledger. A user can only record events
    // for themselves. No one (not even admin) can edit or delete events.
    match /events/{eventId} {
      allow read: if isAuthed() && (
        resource.data.userId == request.auth.uid ||
        isMemberOfGroup(resource.data.boardId)
      );
      // B5: Allow user or fellow board member/admin to record events (e.g. CARD_COMPLETE by admin, PEER_EVAL by reviewer)
      allow create: if isAuthed() && (
        request.resource.data.userId == request.auth.uid ||
        ('boardId' in request.resource.data && isMemberOfGroup(request.resource.data.boardId))
      );
      allow update: if false; // Events are immutable
      allow delete: if false; // Events are immutable
    }

    // ── Points Ledger ────────────────────────────────────────────────
    match /points/{pointId} {
      allow read: if isAuthed() &&
        isMemberOfGroup(resource.data.groupId);
      allow create: if isWritingToOwnGroup() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAuthed() &&
        resource.data.uid == request.auth.uid;
      allow delete: if false; // Points ledger is immutable
    }

    // ── Proof Submissions ────────────────────────────────────────────
    // Members submit proof of work completion.
    // All group members can read submissions (for transparency).
    // Only the submitter can create; admin can approve/reject/delete.
    match /proofSubmissions/{submissionId} {
      allow read: if isAuthed() &&
        isMemberOfGroup(resource.data.groupId);
      // B7: memberId is composite groupId_uid
      allow create: if isWritingToOwnGroup() &&
        request.resource.data.memberId == (request.resource.data.groupId + '_' + request.auth.uid);
      allow update: if isAuthed() && (
        resource.data.memberId == (resource.data.groupId + '_' + request.auth.uid) ||
        isGroupAdmin(resource.data.groupId)
      );
      allow delete: if isAuthed() &&
        isGroupAdmin(resource.data.groupId);
    }

    // ── Audit Requests ───────────────────────────────────────────────
    match /auditRequests/{requestId} {
      allow read: if isAuthed() &&
        isMemberOfGroup(resource.data.groupId);
      allow create: if isWritingToOwnGroup();
      allow update: if isAuthed() && (
        resource.data.requestedBy == request.auth.uid ||
        isGroupAdmin(resource.data.groupId)
      );
      allow delete: if isAuthed() &&
        isGroupAdmin(resource.data.groupId);
    }

    // ── Activity Log ─────────────────────────────────────────────────
    // All members can read the activity log; it is append-only.
    // No one can edit or delete log entries.
    match /activityLog/{logId} {
      allow read: if isAuthed() &&
        isMemberOfGroup(resource.data.groupId);
      allow create: if isWritingToOwnGroup();
      allow update: if false; // Audit logs are immutable
      allow delete: if false;
    }

    // ── Notifications ────────────────────────────────────────────────
    // A user can only read and update their own notifications.
    // Any authenticated user can create a notification (for notifying others).
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthed() &&
        resource.data.uid == request.auth.uid;
      allow create: if isAuthed() &&
        'uid' in request.resource.data;
    }

    // ── User Profiles ────────────────────────────────────────────────
    // Any authenticated user can READ any profile (needed for avatar/photo display
    // across the board — leaderboard, member list, task cards, chat, etc.).
    // Only the profile owner can WRITE their own document.
    match /userProfiles/{uid} {
      allow read: if isAuthed();
      allow write: if isAuthed() && request.auth.uid == uid;
    }

  }
}
